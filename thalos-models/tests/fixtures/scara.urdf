<?xml version="1.0" encoding="utf-8"?>
<robot name="scara">
  <!-- SCARA robot matching the canonical spec in thalos-core:
       base_height=0.5, a1=1.0, a2=0.8
       joint_1: revolute, ±140°
       joint_2: revolute, ±150°
       joint_3: prismatic, [-0.5, 0.0]
       joint_4: revolute, ±360° (continuous)
  -->

  <!-- ─── Links ─── -->

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
  </link>

  <link name="link_1">  <!-- upper arm -->
    <visual>
      <geometry>
        <cylinder radius="0.05" length="1.0"/>
      </geometry>
      <origin rpy="0 1.5708 0" xyz="0.5 0 0"/>
    </visual>
  </link>

  <link name="link_2">  <!-- forearm -->
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.8"/>
      </geometry>
      <origin rpy="0 1.5708 0" xyz="0.4 0 0"/>
    </visual>
  </link>

  <link name="link_3">  <!-- tool lift -->
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.25"/>
    </visual>
  </link>

  <link name="tool0">  <!-- end effector -->
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
  </link>

  <!-- ─── Joints ─── -->

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-2.44346" upper="2.44346" effort="10" velocity="1"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="1.0 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="10" velocity="1"/>
  </joint>

  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="0.8 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.0" effort="10" velocity="0.5"/>
  </joint>

  <joint name="joint_4" type="continuous">
    <parent link="link_3"/>
    <child  link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="5" velocity="2"/>
  </joint>
</robot>
