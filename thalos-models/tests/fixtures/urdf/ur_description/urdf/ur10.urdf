    <inertial>
      <mass value="1.96"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.005108" ixy="0.0" ixz="0.0" iyy="0.005108" iyz="0.0" izz="0.0055125"/>
    </inertial>
  </link>

  <!-- wrist_3_joint -->
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.1157" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="54.0" velocity="3.2"/>
  </joint>

  <!-- wrist_3_link -->
  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
