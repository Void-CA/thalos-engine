    <inertial>
      <mass value="0.202"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000526" ixy="0.0" ixz="0.0" iyy="0.000526" iyz="0.0" izz="0.000568"/>
    </inertial>
  </link>

  <!-- tool0 -->
  <joint name="wrist_3_link-tool0_fixed_joint" type="fixed">
    <origin xyz="0 0.0922 0" rpy="-1.5707963267948966 0 0"/>
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
  </joint>

  <link name="tool0"/>

  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
