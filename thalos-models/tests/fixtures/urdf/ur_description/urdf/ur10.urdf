    </collision>
    <inertial>
      <mass value="12.93"/>
      <origin rpy="0 0 0" xyz="0 0 0.306"/>
      <inertia ixx="0.42175" ixy="0.0" ixz="0.0" iyy="0.42175" iyz="0.0" izz="0.036365"/>
    </inertial>
  </link>

  <!-- elbow_joint -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.1719 0.612" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="150.0" velocity="3.15"/>
  </joint>

  <!-- forearm_link -->
  <link name="forearm_link">
