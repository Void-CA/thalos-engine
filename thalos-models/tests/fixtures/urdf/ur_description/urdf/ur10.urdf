  </link>

  <!-- wrist_1_joint -->
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.5723" rpy="0 1.5707963267948966 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="54.0" velocity="3.2"/>
  </joint>

  <!-- wrist_1_link -->
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
