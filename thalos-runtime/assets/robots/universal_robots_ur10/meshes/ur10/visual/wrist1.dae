<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASpec" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="wrist1-mesh" name="wrist1">
      <mesh>
        <source id="wrist1-positions">
          <float_array id="wrist1-positions-array" count="9">0 0 0 1 0 0 0 1 0</float_array>
          <technique_common>
            <accessor source="#wrist1-positions-array" count="3" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="wrist1-normals">
          <float_array id="wrist1-normals-array" count="9">0 0 1 0 0 1 0 0 1</float_array>
          <technique_common>
            <accessor source="#wrist1-normals-array" count="3" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="wrist1-vertices">
          <input semantic="POSITION" source="#wrist1-positions"/>
        </vertices>
        <triangles count="1">
          <input semantic="VERTEX" source="#wrist1-vertices" offset="0"/>
          <input semantic="NORMAL" source="#wrist1-normals" offset="1"/>
          <p>0 0 1 1 2 2</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
</COLLADA>
